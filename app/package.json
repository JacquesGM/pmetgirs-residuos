{
  "name": "pmetgirs-spa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pmetgirs \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-pmetgirs",
    "rules:check": "firebase deploy --only firestore:rules --dry-run --project demo-pmetgirs",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "migrate:dry-run": "tsx scripts/migrate-json.ts",
    "migrate:emulator": "tsx scripts/migrate-json.ts --emulator",
    "migrate:prod": "tsx scripts/migrate-json.ts --production"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.27.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
