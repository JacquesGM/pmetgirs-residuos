# PMetGIRS — variáveis de ambiente do cliente
#
# Copie para `.env.local` e preencha. O `.env.local` está no .gitignore e
# NUNCA deve ser commitado.
#
# ATENÇÃO — o que pode e o que não pode ficar aqui:
#
#   PODE: a configuração web do Firebase abaixo. Ela é pública por natureza —
#   vai embutida no bundle que qualquer visitante baixa. Não é segredo, e não
#   protege nada. Quem protege os dados são as Security Rules e o App Check.
#
#   NÃO PODE, JAMAIS: chave de service account, chave privada, senha de
#   usuário, token de administrador, string de conexão ou qualquer credencial
#   do Admin SDK. Nada disso entra em arquivo .env, no bundle, no repositório
#   ou em mensagem de chat. O bootstrap do proprietário usa credencial de
#   aplicação padrão, obtida por `gcloud auth application-default login`, e a
#   credencial nunca é gravada no projeto.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Endereço oficial do portal, sem barra final. Usado na URL canônica e no
# og:url. Precisa ser fixo: com mais de um host servindo o mesmo conteúdo, uma
# canônica derivada do host faz cada cópia se declarar oficial.
VITE_SITE_URL=https://teste-e003c.web.app

# Identificador do workspace inicial.
VITE_WORKSPACE_ID=pmetgirs-rmrj

# App Check — chave de site do reCAPTCHA Enterprise.
# A chave de site é pública; a chave secreta fica no console e não vem para cá.
VITE_APPCHECK_RECAPTCHA_SITE_KEY=

# Desenvolvimento local com o Emulator Suite.
# Com 'true', o app fala com os emuladores e nunca com dados de produção.
VITE_USE_FIREBASE_EMULATOR=true

# Token de depuração do App Check — SOMENTE local.
# Gerado pelo navegador na primeira execução. Nunca commite este valor e
# nunca o cadastre num ambiente compartilhado.
VITE_APPCHECK_DEBUG_TOKEN=

# Aviso de protótipo no portal público. Deixe 'true' enquanto o sistema
# estiver em domínio ou conta pessoal.
VITE_PROTOTYPE_NOTICE=true
